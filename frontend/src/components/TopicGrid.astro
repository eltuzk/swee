---
/**
 * Grid of lesson groups for the home page. Built from Starlight's sidebar route data,
 * so group labels, lesson titles and links are already in the page's locale.
 * Usage (MDX): <TopicGrid />
 */
const t = Astro.locals.t;
const { sidebar } = Astro.locals.starlightRoute;

type Entry = (typeof sidebar)[number];
type Link = Extract<Entry, { type: 'link' }>;

const flattenLinks = (entries: Entry[]): Link[] =>
	entries.flatMap((e) => (e.type === 'link' ? [e] : flattenLinks(e.entries)));

const topics = sidebar
	.filter((e) => e.type === 'group')
	.map((group) => ({ label: group.label, links: flattenLinks(group.entries) }))
	.filter((topic) => topic.links.length > 0);
---

<ul class="swee-topics not-content">
	{topics.map((topic) => (
		<li>
			<a class="swee-topic" href={topic.links[0]!.href}>
				<span class="swee-topic-label">{topic.label}</span>
				<span class="swee-topic-lessons">{topic.links.map((l) => l.label).join(' · ')}</span>
				<span class="swee-topic-count">{t('swee.lessonCount', { count: topic.links.length })}</span>
			</a>
		</li>
	))}
</ul>

<style>
	.swee-topics {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: 0.75rem;
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
	}
	.swee-topic {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		height: 100%;
		padding: 1.125rem 1.25rem;
		border-radius: var(--swee-radius-lg);
		background-color: var(--swee-surface);
		color: inherit;
		text-decoration: none;
	}
	.swee-topic:hover {
		background-color: var(--swee-surface-hover);
	}
	.swee-topic:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	.swee-topic-label {
		font-size: var(--sl-text-lg);
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	.swee-topic-lessons {
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-3);
	}
	.swee-topic-count {
		margin-top: auto;
		padding-top: 0.5rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}
</style>
